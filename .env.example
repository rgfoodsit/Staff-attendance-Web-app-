# puchIn - Staff Attendance & Workforce Intelligence Platform
# Production Environment Variables

# Supabase Project URL & Anon Key (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (Required for admin/background automation tasks)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Maps Geocoding API Key (Optional: fallbacks to OpenStreetMap reverse geocoding if not provided)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
